# HakiOS fragment: the POCO X6 Pro 5G (duchamp) -- what is true of this phone and of no other with an MT6897.
# Step 2 of the guide: boot with nothing of the phone's. Every phone driver is left out until a run has shown it working here;
# the root is the payload's RAM disk (mtkloader adds rd=md0), the screen is LK's framebuffer as it stands.
# The panel is 1220 x 2712 at 480 dpi: iOS at scale 3 would be 406 x 904 points, at 2 610 x 1356; 2 to begin with, as on the
# X6826B (fbscale/fbfit are the common kernel's framebuffer arguments).
CONFIG_DEVICE="duchamp"
CONFIG_FBSCALE=2
# (the X6826B's drivers, not this phone's hardware: no TD4160, no eMMC, no Mali-G52, no PWRAP)
# CONFIG_HAKIOS_TCM is not set
# CONFIG_MALI is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# (CONFIG_UFS, ufs=, is only read by CONFIG_HAKIOS_UFS, which is left out: the common driver is Qualcomm's controller at
# 0x1d84000 and is not built here, so nothing reads the flash)
# no firmware wanted yet (pull-firmware.sh is for the later steps)
CONFIG_FIRMWARE="none"
CONFIG_BOOTARGS=""
